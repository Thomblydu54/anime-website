---
import Container from "./Container.astro";
import Button from "./Button.astro";
import PhoneMockup from "./PhoneMockup.astro";
---

<section class="relative isolate min-h-screen overflow-hidden">

  <!-- Main halo -->
  <div
    class="pointer-events-none absolute left-1/2 top-24 h-[700px] w-[700px] -translate-x-1/2 rounded-full bg-violet-600/20 blur-[170px]">
  </div>

  <!-- Secondary halo -->
  <div
    class="pointer-events-none absolute right-0 top-0 h-[350px] w-[350px] rounded-full bg-sky-500/10 blur-[120px]">
  </div>

  <!-- Content -->
  <div class="relative z-20">

    <Container>

      <div class="grid min-h-screen items-center gap-16 pt-24 lg:grid-cols-2 lg:gap-20">

        <!-- Text -->
        <div class="relative z-30">

          <span class="inline-flex rounded-full border border-violet-500/30 bg-violet-500/10 px-4 py-2 text-sm font-medium">
            ✨ Developed by Thomblydu54
          </span>

          <h1 class="mt-8 text-5xl font-black leading-tight lg:text-7xl">
            Your
            <br />
            <span class="text-violet-400">
              Anime
            </span>
            Universe on Android.
          </h1>

          <p class="mt-8 max-w-xl text-lg leading-8 text-zinc-400">
            Watch your favorite anime, manage your watchlists, keep track of upcoming
            releases, download your episodes, and enjoy a modern interface
            designed for Japanese animation fans.
          </p>

          <!-- Buttons -->
          <div class="relative z-40 mt-12 flex flex-wrap gap-4">

            <Button href="https://github.com/Thomblydu54/Anime/releases/latest/download/Anime.apk">
              ⬇ Download APK
            </Button>

            <Button
              href="https://github.com/Thomblydu54/Anime"
              variant="secondary">

              View on GitHub

            </Button>

          </div>

          <!-- Badges -->
          <div class="mt-10 flex flex-wrap gap-3">

            <span class="rounded-full bg-white/5 px-5 py-2 text-sm">
              📱 Android 8+
            </span>

            <span class="rounded-full bg-white/5 px-5 py-2 text-sm">
              💜 Free
            </span>

            <span class="rounded-full bg-white/5 px-5 py-2 text-sm">
              ⚡ Fast
            </span>

            <span class="rounded-full bg-white/5 px-5 py-2 text-sm">
              🎬 Streaming
            </span>

          </div>

          <!-- Statistics -->
          <div class="mt-12 grid grid-cols-3 gap-8">

            <div>
              <h3 class="text-4xl font-black">100%</h3>
              <p class="text-zinc-500">Free</p>
            </div>

            <div>
              <h3 class="text-4xl font-black">8+</h3>
              <p class="text-zinc-500">Android</p>
            </div>

            <div>
              <h3 class="text-4xl font-black">∞</h3>
              <p class="text-zinc-500">Anime</p>
            </div>

          </div>

        </div>

        <!-- Phone -->
        <div class="relative z-10 flex justify-center">

          <PhoneMockup />

        </div>

      </div>

    </Container>

  </div>

</section>