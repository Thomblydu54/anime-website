---
import Container from "./Container.astro";
import SectionTitle from "./SectionTitle.astro";

const features = [
  {
    icon: "🎬",
    title: "Built-in Player",
    description:
      "Watch your favorite anime directly within the app using a modern and seamless video player."
  },
  {
    icon: "📅",
    title: "Schedule",
    description:
      "Stay up to date with upcoming releases and never miss a new episode of your favorite series."
  },
  {
    icon: "❤️",
    title: "Favorites",
    description:
      "Save your favorite anime to your personal library for quick and easy access."
  },
  {
    icon: "⬇️",
    title: "Downloads",
    description:
      "Download episodes to watch offline wherever you are."
  },
  {
    icon: "🏆",
    title: "Achievements",
    description:
      "Unlock achievements and track your progress directly within the app."
  },
  {
    icon: "⚡",
    title: "Fast",
    description:
      "An optimized interface designed for smooth, responsive navigation on Android."
  }
];
---

<section id="features" class="py-32">

  <Container>

    <SectionTitle
      title="Features"
      subtitle="Everything you need to watch, track, and manage your anime in one app."
    />

    <div class="mt-16 grid gap-8 md:grid-cols-2 xl:grid-cols-3">

      {
        features.map((feature) => (

          <article
            class="group flex h-full flex-col rounded-3xl border border-white/10 bg-white/5 p-8 backdrop-blur-xl transition-all duration-300 hover:-translate-y-2 hover:border-violet-500/40 hover:bg-white/10 hover:shadow-[0_20px_60px_rgba(139,92,246,.20)]">

            <div class="flex h-16 w-16 items-center justify-center rounded-2xl bg-violet-500/10 text-4xl transition-transform duration-300 group-hover:scale-110">
              {feature.icon}
            </div>

            <h3 class="mt-8 text-2xl font-bold">
              {feature.title}
            </h3>

            <p class="mt-4 flex-1 leading-7 text-zinc-400">
              {feature.description}
            </p>

          </article>

        ))
      }

    </div>

  </Container>

</section>