---
import Container from "./Container.astro";
import Button from "./Button.astro";
import SectionTitle from "./SectionTitle.astro";
---

<section id="download" class="py-32">
  <Container>
    <SectionTitle
      title="Download Anime"
      subtitle="Download the latest official version of the app for free."
    />

    <div
      class="mx-auto mt-16 max-w-4xl rounded-[32px] border border-white/10 bg-white/5 p-10 backdrop-blur-xl">

      <div class="text-center">

        <h3 class="text-3xl font-bold">
          Current Version
        </h3>

        <p class="mt-4 text-lg text-zinc-400">
          Available directly from GitHub Releases.
          Fast, free, and always up-to-date downloads.
        </p>

        <div class="mt-8 flex flex-wrap justify-center gap-3">

          <span class="rounded-full bg-violet-500/20 px-4 py-2 text-sm">
            📱 Android 8+
          </span>

          <span class="rounded-full bg-violet-500/20 px-4 py-2 text-sm">
            💜 Free
          </span>

          <span class="rounded-full bg-violet-500/20 px-4 py-2 text-sm">
            🚫 No intrusive ads
          </span>

          <span class="rounded-full bg-violet-500/20 px-4 py-2 text-sm">
            ⚡ Always up to date
          </span>

        </div>

        <div class="mt-12 flex justify-center">

          <Button href="https://github.com/Thomblydu54/Anime/releases/latest/download/Anime.apk">
            ⬇ Download APK
          </Button>

        </div>

      </div>

    </div>

  </Container>
</section>