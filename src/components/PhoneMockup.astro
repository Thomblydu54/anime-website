---
const BASE_URL = import.meta.env.BASE_URL;

const screenshots = [
  `${BASE_URL}screenshots/home1.jpg`,
  `${BASE_URL}screenshots/home2.jpg`,
  `${BASE_URL}screenshots/home3.jpg`,
  `${BASE_URL}screenshots/historical.jpg`,
  `${BASE_URL}screenshots/download.jpg`,
  `${BASE_URL}screenshots/my_list.jpg`,
  `${BASE_URL}screenshots/settings.jpg`,
  `${BASE_URL}screenshots/planning.jpg`,
];
---

<div class="phone-wrapper">

  <!-- Halo lumineux -->
  <div class="phone-halo"></div>

  <!-- Téléphone -->
  <div id="phone" class="phone">

    <!-- Captures -->
    <div class="screens-container">

      {
        screenshots.map((image, index) => (
          <img
            src={image}
            alt={`Capture d'écran ${index + 1} de l'application Anime`}
            loading={index === 0 ? "eager" : "lazy"}
            class:list={[
              "screen",
              index === 0 && "active"
            ]}
          />
        ))
      }

    </div>

    <!-- Encoche -->
    <div class="phone-notch"></div>

    <!-- Reflet lumineux -->
    <div class="phone-glare"></div>

    <!-- Reflet permanent très léger -->
    <div class="phone-overlay"></div>

  </div>

</div>

<script>
  const phone = document.getElementById("phone");

  if (phone) {

    const screens = phone.querySelectorAll(".screen");

    let current = 0;

    if (screens.length > 1) {

      setInterval(() => {

        screens[current].classList.remove("active");

        current = (current + 1) % screens.length;

        screens[current].classList.add("active");

      }, 3500);

    }

  }
</script>

<style>

.phone-wrapper {

  position: relative;

  display: flex;

  justify-content: center;

  align-items: center;

  width: 100%;

  min-height: 620px;

  animation: phoneFloat 5s ease-in-out infinite;

  pointer-events: none;

}

/* ===========================
   HALO
=========================== */

.phone-halo {

  position: absolute;

  width: 460px;

  height: 460px;

  border-radius: 50%;

  background:
    rgba(139, 92, 246, 0.22);

  filter: blur(110px);

  pointer-events: none;

}

/* ===========================
   TÉLÉPHONE
=========================== */

.phone {

  position: relative;

  z-index: 2;

  width: 380px;

  max-width: 82vw;

  aspect-ratio: 9 / 19;

  overflow: hidden;

  border-radius: 42px;

  background: #000;

  border: 10px solid #151515;

  box-shadow:
    0 40px 80px rgba(0, 0, 0, 0.60),
    0 0 80px rgba(139, 92, 246, 0.30);

  transform: none;

  isolation: isolate;

  pointer-events: none;

}

/* ===========================
   IMAGES
=========================== */

.screens-container {

  position: absolute;

  inset: 0;

  z-index: 1;

  overflow: hidden;

}

.screen {

  position: absolute;

  inset: 0;

  width: 100%;

  height: 100%;

  object-fit: cover;

  opacity: 0;

  transform: scale(1.02);

  transition:
    opacity 0.8s ease,
    transform 0.8s ease;

  pointer-events: none;

}

.screen.active {

  opacity: 1;

  transform: scale(1);

}

/* ===========================
   ENCOCHE
=========================== */

.phone-notch {

  position: absolute;

  top: 10px;

  left: 50%;

  width: 120px;

  height: 24px;

  transform: translateX(-50%);

  border-radius: 999px;

  background: #080808;

  z-index: 30;

  box-shadow:
    0 2px 8px rgba(0, 0, 0, 0.5);

  pointer-events: none;

}

/* ===========================
   REFLET LUMINEUX
=========================== */

.phone-glare {

  position: absolute;

  top: -20%;

  left: -60%;

  width: 45%;

  height: 140%;

  z-index: 20;

  pointer-events: none;

  background:
    linear-gradient(
      90deg,
      transparent 0%,
      rgba(255, 255, 255, 0.02) 25%,
      rgba(255, 255, 255, 0.22) 50%,
      rgba(255, 255, 255, 0.02) 75%,
      transparent 100%
    );

  transform:
    skewX(-20deg);

  animation:
    phoneShine 5s ease-in-out infinite;

}

/* ===========================
   REFLET LÉGER PERMANENT
=========================== */

.phone-overlay {

  position: absolute;

  inset: 0;

  z-index: 10;

  pointer-events: none;

  border-radius: 32px;

  background:
    linear-gradient(
      120deg,
      rgba(255, 255, 255, 0.08),
      transparent 25%,
      transparent 75%,
      rgba(139, 92, 246, 0.05)
    );

}

/* ===========================
   FLOTTEMENT
=========================== */

@keyframes phoneFloat {

  0%,
  100% {
    transform:
      translateY(0);
  }

  50% {
    transform:
      translateY(-12px);
  }

}

/* ===========================
   ANIMATION REFLET
=========================== */

@keyframes phoneShine {

  0% {
    left: -60%;
    opacity: 0;
  }

  10% {
    opacity: 1;
  }

  50% {
    opacity: 1;
  }

  90% {
    opacity: 1;
  }

  100% {
    left: 130%;
    opacity: 0;
  }

}

/* ===========================
   MOBILE
=========================== */

@media (max-width: 640px) {

  .phone-wrapper {

    min-height: 520px;

  }

  .phone {

    width: 300px;

    max-width: 76vw;

    border-width: 8px;

    border-radius: 34px;

  }

  .phone-notch {

    top: 8px;

    width: 90px;

    height: 18px;

  }

  .phone-overlay {

    border-radius: 26px;

  }

  .phone-halo {

    width: 320px;

    height: 320px;

    filter: blur(80px);

  }

}

/* ===========================
   PETITS ÉCRANS
=========================== */

@media (max-width: 380px) {

  .phone-wrapper {

    min-height: 460px;

  }

  .phone {

    width: 260px;

    max-width: 72vw;

  }

}

</style>